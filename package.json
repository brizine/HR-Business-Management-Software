{
  "name": "crewdesk",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:api": "pnpm --filter @crewdesk/api dev",
    "dev:web": "pnpm --filter @crewdesk/web dev",
    "dev:mobile": "pnpm --filter @crewdesk/mobile start",
    "db:migrate": "pnpm --filter @crewdesk/api db:migrate",
    "db:seed": "pnpm --filter @crewdesk/api db:seed",
    "build": "pnpm --filter @crewdesk/web build:prod && pnpm --filter @crewdesk/api build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "start": "NODE_ENV=production node --env-file-if-exists=apps/api/.env apps/api/dist/main.js"
  },
  "engines": {
    "node": ">=22"
  }
}
