# ---- Database ----
DATABASE_URL=postgres://crewdesk:crewdesk@localhost:5432/crewdesk

# ---- Security ----
# Long random string, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
# Secret for the cron URL POST /api/jobs/run (production). Leave blank to disable that URL.
JOBS_SECRET=
# Sign-up is open only until the first company exists. Set true to let more companies sign up.
ALLOW_SIGNUP=false

# ---- Server ----
PORT=4000
# Origins allowed to call the API from a browser (development: the web dev server)
CORS_ORIGINS=http://localhost:3000
# Set to true if you run the scheduled checks from an external cron instead of the built-in timer
DISABLE_SCHEDULER=false

# ---- Uploaded documents ----
# Local folder. In production use an absolute path OUTSIDE the deployed code so redeploys keep it.
UPLOAD_DIR=./uploads
# Or an S3-compatible bucket (Amazon S3, Cloudflare R2, Backblaze B2). Setting S3_BUCKET switches to it.
S3_BUCKET=
S3_REGION=auto
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com  (leave blank for Amazon S3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Links in emails and texts ----
WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# ---- Email (any SMTP provider; SiteGround mailboxes work) ----
# e.g. smtps://no-reply%40yourdomain.com:PASSWORD@mail.yourdomain.com:465  (encode @ in the username as %40)
SMTP_URL=
EMAIL_FROM="Crewdesk <no-reply@yourdomain.com>"

# ---- Text messages via Twilio (optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# ---- Push ----
# Only if "enhanced push security" is enabled for your Expo project
EXPO_ACCESS_TOKEN=

# ---- Payroll ----
CHECK_API_KEY=
CHECK_API_URL=https://sandbox.checkhq.com
