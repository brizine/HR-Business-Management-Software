DATABASE_URL=postgres://crewdesk:crewdesk@localhost:5432/crewdesk
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Comma-separated origins allowed to call the API (web app)
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
# Payroll provider: "csv" (export only) or "check" (Check embedded payroll API)
CHECK_API_KEY=
CHECK_API_URL=https://sandbox.checkhq.com
# Optional: only needed if "enhanced push security" is enabled for your Expo project
EXPO_ACCESS_TOKEN=
# Set to true if you run `pnpm jobs:run` from an external cron instead of the built-in timer
DISABLE_SCHEDULER=false
# Where links in emails and texts point
WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Email: any SMTP provider, e.g. smtp://USER:PASS@smtp.postmarkapp.com:587 (leave blank to disable email)
SMTP_URL=
EMAIL_FROM="Crewdesk <no-reply@yourdomain.com>"
# Text messages via Twilio (leave blank to disable). Prefer a Messaging Service SID over a From number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
